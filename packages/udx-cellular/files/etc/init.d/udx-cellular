#!/bin/sh /etc/rc.common
START=84
STOP=12
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/udx-cellulard
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	# The service reopens AT after a timeout; procd respawn remains disabled.
	procd_close_instance
}
stop_service() {
	ubus -t 12 call udx.cellular quiesce >/dev/null ||
		logger -p daemon.err -t udx-cellular 'Service quiesce failed or timed out; continuing stop'
}
