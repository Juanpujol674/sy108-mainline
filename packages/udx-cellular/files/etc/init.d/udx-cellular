#!/bin/sh /etc/rc.common
START=84
STOP=12
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/udx-cellulard
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 240
	# The service reopens AT after a timeout; procd respawn remains disabled.
	procd_close_instance
}
stop_service() {
	# rc.common ignores a stop_service return value before procd_kill.
	/usr/sbin/udx-system-quiesce --cellular-only || exit 1
}
