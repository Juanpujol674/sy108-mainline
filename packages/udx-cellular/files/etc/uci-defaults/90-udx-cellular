#!/bin/sh
# Add only the unconfigured cellular WAN; preserve a user's other uplinks.
kind=$(uci -q get network.wan)
if [ -z "$kind" ]; then
	uci set network.wan=interface
	uci set network.wan.device=sipa_eth0
	uci set network.wan.proto=udx
	uci set network.wan.metric=50
	uci commit network
elif [ "$(uci -q get network.wan.device)" = sipa_eth0 ]; then
	case "$(uci -q get network.wan.proto)" in
		''|none) uci set network.wan.proto=udx; uci commit network ;;
	esac
fi
exit 0
