#!/bin/sh
. /usr/lib/udx-usb/gadget.sh
g_state_load "$UDX_RUN/applied" || exit 1
[ "$ACM" = 1 ] || exit 0
reason=$(g_console_reason) || { g_error "console disabled: $reason"; exit 1; }
[ -c /dev/ttyGS0 ] || exit 1
getty=$(g_console_getty) || exit 1
exec "$getty" -n -L -l /usr/libexec/udx-usb-login ttyGS0 115200 vt100
