{
 "luci-mod-system-flash": {
  "description": "SY108 platform actions on standard LuCI pages",
  "read": {
   "file": {
    "/proc/sys/kernel/random/boot_id": [
     "read"
    ],
    "/etc/udx-recovery-root": [
     "list"
    ]
   },
   "ubus": {
    "file": [
     "read",
     "stat"
    ]
   }
  },
  "write": {
   "file": {
    "/usr/libexec/sy108-system reboot openwrt": [
     "exec"
    ],
    "/usr/libexec/sy108-system reboot recovery": [
     "exec"
    ],
    "/usr/libexec/sy108-system reset": [
     "exec"
    ]
   },
   "ubus": {
    "file": [
     "exec"
    ]
   }
  }
 },
 "luci-mod-system-reboot": {
  "description": "SY108 platform actions on standard LuCI pages",
  "read": {
   "file": {
    "/proc/sys/kernel/random/boot_id": [
     "read"
    ],
    "/etc/udx-recovery-root": [
     "list"
    ]
   },
   "ubus": {
    "file": [
     "read",
     "stat"
    ]
   }
  },
  "write": {
   "file": {
    "/usr/libexec/sy108-system reboot openwrt": [
     "exec"
    ],
    "/usr/libexec/sy108-system reboot recovery": [
     "exec"
    ],
    "/usr/libexec/sy108-system reset": [
     "exec"
    ]
   },
   "ubus": {
    "file": [
     "exec"
    ]
   }
  }
 }
}
