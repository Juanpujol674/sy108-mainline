#!/bin/sh
# Read the local main-system identity; never write the configuration volume.
set -eu
mountpoint=/tmp/sy108-local-identity
mkdir -p "$mountpoint" /etc/dropbear /root/.ssh
if mount -t ubifs -o ro ubi0:rootfs_data "$mountpoint" 2>/dev/null; then
    trap 'umount "$mountpoint"; rmdir "$mountpoint"' EXIT
    for name in dropbear_ed25519_host_key authorized_keys; do
        source="$mountpoint/upper/etc/dropbear/$name"
        [ -f "$source" ] && [ ! -L "$source" ] || continue
        cp "$source" "/etc/dropbear/$name"
        chmod 600 "/etc/dropbear/$name"
    done
    source="$mountpoint/upper/root/.ssh/authorized_keys"
    if [ -f "$source" ] && [ ! -L "$source" ]; then
        cp "$source" /root/.ssh/authorized_keys
        chmod 600 /root/.ssh/authorized_keys
    fi
else
    rmdir "$mountpoint"
fi
exit 0
