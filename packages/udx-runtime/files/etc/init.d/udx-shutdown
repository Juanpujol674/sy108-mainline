#!/bin/sh /etc/rc.common
# Must precede USB K10, cellular K12, CPNV K15 and standard umount K90.
# shellcheck disable=SC2034
STOP=9
stop() {
	/usr/libexec/udx-wait-quiesce && return 0
	logger -p daemon.err -t udx-shutdown 'Quiesce failed; normal shutdown stopped, protected Recovery deadline retained'
	/usr/sbin/udx-runtime --stop || true
	# Do not let later shutdown scripts mistake a failure for completed NV drain.
	while :; do sleep 1; done
}
