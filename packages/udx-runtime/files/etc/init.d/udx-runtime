#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
START=11
# shellcheck disable=SC2034
STOP=89
# shellcheck disable=SC2034
USE_PROCD=1
start_service() {
	mkdir -p /run
	procd_open_instance
	procd_set_param command /usr/sbin/udx-runtime --serve
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	# The sole PMIC watchdog owner is never automatically respawned.
	procd_close_instance
}
