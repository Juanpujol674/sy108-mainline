#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
START=11
# shellcheck disable=SC2034
STOP=89
# shellcheck disable=SC2034
USE_PROCD=1
start_service() {
	mkdir -p /run
	local ddr=/sys/devices/platform/scene-frequency
	if [ -e "$ddr/firmware_auto_enabled" ]; then
		echo 1 > "$ddr/firmware_dfs_enabled" || logger -p daemon.warning -t udx-runtime 'DDR DFS setting failed'
		echo 1 > "$ddr/firmware_auto_enabled" || logger -p daemon.warning -t udx-runtime 'DDR auto setting failed'
		echo 0 > "$ddr/ap_vote_hz" || logger -p daemon.warning -t udx-runtime 'DDR AP vote setting failed'
	fi
	procd_open_instance
	procd_set_param command /usr/sbin/udx-runtime --serve
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 20
	# The sole local lease owner is never automatically respawned.
	procd_close_instance
}
