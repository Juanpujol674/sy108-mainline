#!/bin/sh
set -eu
# config_generate provides the standard system defaults. Keep restored values.
case "$(uci -q get system.@system[0].hostname)" in
	''|OpenWrt) uci set system.@system[0].hostname=sy108; uci commit system;;
esac
# Cooperative CP/NV shutdown is bounded at 330 seconds. Let standard rpcd
# file.exec finish sysupgrade preparation instead of killing it after 30 s.
uci set rpcd.@rpcd[0].timeout=360
uci commit rpcd
uci set uhttpd.main.script_timeout=360
uci commit uhttpd
if [ "$(awk -F: '$1 == "root" {print $2}' /etc/shadow)" = '!' ] ||
			[ -z "$(awk -F: '$1 == "root" {print $2}' /etc/shadow)" ]; then
				printf 'root:admin\n' | chpasswd
fi
exit 0
