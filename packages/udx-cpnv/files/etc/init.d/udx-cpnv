#!/bin/sh /etc/rc.common
START=14
STOP=15
USE_PROCD=1
start_service() {
	[ -r /etc/udx-cpnv-warm/halo-private.bin ] || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/udx-cpnv-start start
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 90
	# A failed NV/CP transaction is not an automatic cold-load retry.
	procd_close_instance
}
stop_service() {
	# Retire the cellular network and its AT owner before native CP/NV shutdown.
	# rc.common otherwise calls procd_kill even after stop_service returns 1.
	[ ! -x /usr/sbin/udx-system-quiesce ] || /usr/sbin/udx-system-quiesce || exit 1
}
